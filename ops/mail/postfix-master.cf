# No chroot: packaged DNS/CA updates stay directly available.
smtp      inet n - n - 4 smtpd
submission inet n - n - 4 smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions=reject_authenticated_sender_login_mismatch,reject_non_fqdn_sender
  -o smtpd_milters=
pickup    unix n - n 60 1 pickup
cleanup   unix n - n - 4 cleanup
qmgr      unix n - n 300 1 qmgr
tlsmgr    unix - - n 1000? 1 tlsmgr
rewrite   unix - - n - 2 trivial-rewrite
bounce    unix - - n - 2 bounce
defer     unix - - n - 2 bounce
trace     unix - - n - 2 bounce
verify    unix - - n - 1 verify
flush     unix n - n 1000? 0 flush
proxymap  unix - - n - 2 proxymap
proxywrite unix - - n - 1 proxymap
smtp      unix - - n - 4 smtp
relay     unix - - n - 2 smtp
showq     unix n - n - 2 showq
error     unix - - n - 2 error
retry     unix - - n - 2 error
discard   unix - - n - 1 discard
local     unix - n n - 2 local
virtual   unix - n n - 2 virtual
lmtp      unix - - n - 2 lmtp
anvil     unix - - n - 1 anvil
scache    unix - - n - 1 scache
postlog   unix-dgram n - n - 1 postlogd
